<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>NeoAPIWindows</PackageId>
    <Version>1.5.0</Version>
    <Authors>Baumer</Authors>
    <Description>Baumer NeoAPI wrapper for Windows with native dll binaries. Repackage of official neoapi 1.5.0.</Description>
    <PackageTags>baumer;neoapi;camera</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoPackageAnalysis>false</NoPackageAnalysis>
  </PropertyGroup>

  <!-- NeoAPI.cs is compiled by the SDK into lib/net9.0/NeoAPIWindows.dll -->

  <!-- Native dlls and .cti transport layers → runtimes/win-x64/native/ -->
  <ItemGroup>
    <None Include="runtimes/**/*" PackagePath="runtimes/" Pack="true" />
  </ItemGroup>

  <!-- Build targets → build/. File name MUST match PackageId or NuGet will not import it! -->
  <ItemGroup>
    <None Include="build/*" PackagePath="build/" Pack="true" />
  </ItemGroup>
</Project>

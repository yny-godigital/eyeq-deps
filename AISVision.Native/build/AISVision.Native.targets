<Project>

  <!--
    Deploy AISVision native DLLs and plugins.xml alongside the C++/CLI wrapper
    assemblies in $(OutDir). The wrappers are mixed-mode assemblies; Windows
    DLL search resolves their native dependency chain starting from the wrapper
    directory, so all native DLLs must be co-located.
  -->
  <PropertyGroup>
    <AISVisionNativeSource>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</AISVisionNativeSource>
  </PropertyGroup>

  <ItemGroup>
    <AISVisionNativeDlls Include="$(AISVisionNativeSource)*.dll" Condition="Exists('$(AISVisionNativeSource)')" />
    <AISVisionNativeXml  Include="$(AISVisionNativeSource)plugins.xml" Condition="Exists('$(AISVisionNativeSource)')" />
  </ItemGroup>

  <Target Name="_AISVisionCopyToOutDir"
          BeforeTargets="AssignTargetPaths"
          Condition="'@(AISVisionNativeDlls)' != ''">
    <Copy SourceFiles="@(AISVisionNativeDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AISVisionNativeXml)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="normal"
             Text="AISVision.Native: deployed %(AISVisionNativeDlls.Count) native DLLs to $(OutDir)" />
  </Target>

</Project>

<Project Sdk="Microsoft.Build.NoTargets/3.7.56">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>Nrt.Native</PackageId>
    <Version>1.0.0</Version>
    <Authors>ChewCW</Authors>
    <Description>NRT (Neuro Runtime) inference engine. Includes NrtSdk.dll (SWIG-generated C# P/Invoke wrapper) and native DLLs (OpenVINO, ONNX Runtime, OpenCV, TensorRT, CUDA, DirectML, TBB) for Windows x64.</Description>
    <PackageTags>nrt;neuro-runtime;inference;windows</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoPackageAnalysis>false</NoPackageAnalysis>
  </PropertyGroup>

  <!-- NrtSdk.dll (SWIG-generated C# wrapper) → lib/net9.0/ for compile-time assembly reference -->
  <ItemGroup>
    <None Include="lib/net9.0/*.dll" PackagePath="lib/net9.0/" Pack="true" />
  </ItemGroup>

  <!-- Native dependency DLLs → runtimes/win-x64/native/ for platform-appropriate deployment -->
  <ItemGroup>
    <None Include="runtimes/win-x64/native/*.dll" PackagePath="runtimes/win-x64/native/" Pack="true" />
  </ItemGroup>

  <!-- Build targets → build/ for automatic import by consuming projects -->
  <ItemGroup>
    <None Include="build/*" PackagePath="build/" Pack="true" />
  </ItemGroup>
</Project>

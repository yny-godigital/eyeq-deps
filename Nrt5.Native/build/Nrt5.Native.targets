<Project>
  <PropertyGroup>
    <_Nrt5Deploy Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</_Nrt5Deploy>
    <_Nrt5Deploy Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT' And '$(PlatformTarget)' == 'x64'">true</_Nrt5Deploy>
  </PropertyGroup>

  <ItemGroup Condition="'$(_Nrt5Deploy)' == 'true'">
    <_Nrt5NativeFiles Include="$(MSBuildThisFileDirectory)../runtimes/win-x64/native/*" />
  </ItemGroup>

  <Target Name="CopyNrt5NativeBuildAssets" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'@(_Nrt5NativeFiles)' != '' And '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_Nrt5NativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNrt5NativePublishAssets" AfterTargets="Publish"
          Condition="'@(_Nrt5NativeFiles)' != '' And '$(PublishDir)' != '' And '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_Nrt5NativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

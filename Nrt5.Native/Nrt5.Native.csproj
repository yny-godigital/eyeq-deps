<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>Nrt5.Native</PackageId>
    <Version>5.0.3</Version>
    <Authors>ChewCW</Authors>
    <Description>NRT v5 C# bindings and Windows x64 Release runtime libraries.</Description>
    <PackageTags>nrt;neuro-runtime;inference;windows;x64</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageLicenseFile Condition="Exists('$(MSBuildProjectDirectory)/LICENSE.txt')">LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance Condition="Exists('$(MSBuildProjectDirectory)/LICENSE.txt')">true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="src/Nrt5Sdk/bin/$(Configuration)/net9.0/Nrt5Sdk.dll" PackagePath="lib/net9.0/" Pack="true" />
    <None Include="runtimes/win-x64/native/*" PackagePath="runtimes/win-x64/native/" Pack="true" />
    <None Include="build/Nrt5.Native.targets" PackagePath="build/" Pack="true" />
    <None Include="README.md;THIRD-PARTY-NOTICES.txt" PackagePath="/" Pack="true" />
    <None Include="LICENSE.txt" PackagePath="/" Pack="true" Condition="Exists('LICENSE.txt')" />
  </ItemGroup>

  <Target Name="BuildNrt5ManagedBindings" BeforeTargets="GenerateNuspec">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)/src/Nrt5Sdk/Nrt5Sdk.csproj&quot; --configuration &quot;$(Configuration)&quot;" />
    <Error Condition="'$(Nrt5ForRelease)' == 'true' And !Exists('$(MSBuildProjectDirectory)/LICENSE.txt')"
           Text="NRT redistribution terms are required for a release package." />
  </Target>

</Project>
